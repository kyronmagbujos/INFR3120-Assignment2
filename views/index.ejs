<!-- Include header partial -->
<%- include('partials/header') %>

<div class="container mt-5">
    <div class="hero-card shadow-lg p-5 text-center">
        <!-- Render profile picture avatar from static public images -->
        <img src="/images/pfp.png" class="img-fluid rounded-circle border border-warning shadow mb-4" alt="Kyron Magbujos" style="width: 150px; height: 150px; object-fit: cover;">
        
        <!-- Render dynamic title and message passed from index route -->
        <h1 style="color: var(--gold); font-size: 2.5rem; font-weight: bold;"><%= title %></h1>
        <p class="lead mt-2" style="color: var(--off-white);"><%= message %></p>
        
        <!-- Contact details section -->
        <div class="mt-4">
            <p class="mb-2"><i class="fas fa-envelope text-warning me-2"></i><a href="mailto:kyron.magbujos@ontariotechu.net" class="text-white text-decoration-none">kyron.magbujos@ontariotechu.net</a></p>
            <p><i class="fas fa-map-marker-alt text-warning me-2"></i>Canada</p>
        </div>

        <!-- Social media links using FontAwesome icons -->
        <div class="mt-4">
            <a href="https://github.com/kyronmagbujos" target="_blank" class="text-warning mx-2 fs-3"><i class="fab fa-github"></i></a>
            <a href="https://www.linkedin.com/in/kyron-magbujos-a14a55397/" target="_blank" class="text-warning mx-2 fs-3"><i class="fab fa-linkedin"></i></a>
        </div>
    </div>
</div>

<!-- Include footer partial -->
<%- include('partials/footer') %>
