<!-- Include reusable header partial (includes navbar, Bootstrap, FontAwesome) -->
<%- include('partials/header') %>

<div class="container mt-5">
    <div class="row">
        <!-- Loop through projectList array passed from routes/index.js -->
        <% projectList.forEach(function(project) { %>
            <div class="col-md-4 mb-4">
                <!-- Link card to dynamic project detail route -->
                <a href="/projects/<%= project.id %>" class="text-decoration-none">
                    <div class="card project-card h-100 shadow-sm">
                        <!-- Project Image display -->
                        <div class="p-2">
                            <img src="<%= project.img %>" class="card-img-top rounded border border-secondary" alt="<%= project.name %>" style="height: 200px; object-fit: cover;">
                        </div>
                        
                        <!-- Card body with dynamic title and short description -->
                        <div class="card-body text-center">
                            <h5 class="card-title" style="color: var(--gold);"><%= project.name %></h5>
                            <p class="card-text small" style="color: var(--off-white);"><%= project.desc %></p>
                            
                            <div class="mt-3">
                                <span class="btn btn-sm btn-outline-warning">View Details</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% }); %> <!-- End EJS forEach loop -->
    </div>
</div>

<!-- Include reusable footer partial -->
<%- include('partials/footer') %>
